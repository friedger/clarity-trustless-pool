{
  "name": "x-tests",
  "version": "1.0.0",
  "description": "Run unit tests on this project.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"npm run test:report\"",
    "test:stxer": "npx tsx src/simulations/change-pox-address-stxer.ts",
    "generate:signature": "npx tsx src/signature.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@stacks/clarinet-sdk": "^3.16.0",
    "@stacks/clarunit": "0.1.0",
    "@stacks/common": "^7.0.2",
    "@stacks/network": "^7.2.0",
    "@stacks/stacking": "^7.1.0",
    "@stacks/transactions": "^7.1.0",
    "bitcoinjs-lib": "^7.0.0",
    "chokidar-cli": "^3.0.0",
    "sbtc": "^0.3.2",
    "stxer": "^0.4.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vitest-environment-clarinet": "^3.0.2"
  }
}
