{
  "name": "x-tests",
  "version": "1.0.0",
  "description": "Run unit tests on this project.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"npm run test:report\"",
    "test:stxer": "npx tsx src/simulations/change-pox-address-stxer.ts",
    "fuzz:payout": "rv . payout-self-service-sbtc invariant --dial=scripts/fuzz-dialer.cjs",
    "fuzz:payout:bail": "rv . payout-self-service-sbtc invariant --dial=scripts/fuzz-dialer.cjs --bail",
    "fuzz:pool": "rv ./fuzz-harness pox4-self-service-multi-v2 invariant --dial=../scripts/fuzz-dialer-pool.cjs",
    "fuzz:pool:bail": "rv ./fuzz-harness pox4-self-service-multi-v2 invariant --dial=../scripts/fuzz-dialer-pool.cjs --bail",
    "sim:distribute:happy": "npx tsx src/simulations/reward-distribution-happy-stxer.ts",
    "sim:distribute:no-stake": "npx tsx src/simulations/reward-distribution-no-stake-stxer.ts",
    "sim:distribute:errors": "npx tsx src/simulations/reward-distribution-errors-stxer.ts",
    "sim:distribute:dust": "npx tsx src/simulations/reward-distribution-dust-reclaim-stxer.ts",
    "sim:distribute:excess": "npx tsx src/simulations/reward-distribution-excess-recovery-stxer.ts",
    "generate:signature": "npx tsx src/signature.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@stacks/clarinet-sdk": "^3.16.0",
    "@stacks/clarunit": "0.1.0",
    "@stacks/common": "^7.0.2",
    "@stacks/network": "^7.2.0",
    "@stacks/rendezvous": "^1.0.0-rc.1",
    "@stacks/stacking": "^7.1.0",
    "@stacks/transactions": "^7.1.0",
    "bitcoinjs-lib": "^7.0.0",
    "chokidar-cli": "^3.0.0",
    "sbtc": "^0.3.2",
    "stxer": "^0.4.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vitest-environment-clarinet": "^3.0.2"
  }
}
